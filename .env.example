# ============================================================
# SUPABASE DATABASE CONFIGURATION (Free Tier)
# ============================================================
# Get these from: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Service role key for admin operations (Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# ADMIN DASHBOARD SECURITY
# ============================================================
# Master password to access /admin and /dashboard
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (generate a long random string,
# e.g. `openssl rand -hex 32`). Admin login is disabled unless both are set.
AUTH_SECRET=change-me-to-a-long-random-string
